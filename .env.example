GROQ_API_KEY=your_groq_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Dashboard → Project Settings → API → JWT Settings → JWT Secret (not anon or service_role).
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
OPENCLAW_BASE_URL=https://your-openclaw-domain.example
OPENCLAW_TOOL_API_KEY=your_shared_openclaw_tool_key_here

# Optional pacing values retained for backend-generated outbound workflows.
OUTBOUND_MIN_DELAY=3.0
OUTBOUND_MAX_DELAY=8.0

# Comma-separated browser origins allowed to call this API (plus localhost for Vite).
# Set FRONTEND_URL to the public Railway frontend origin, e.g. https://your-frontend.up.railway.app
CORS_ORIGINS=
FRONTEND_URL=

# Frontend (Vite) build-time: public backend URL, not localhost, when deploying the UI.
# VITE_API_URL=https://your-backend.up.railway.app

