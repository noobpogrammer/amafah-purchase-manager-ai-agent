GROQ_API_KEY=your_groq_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
EVOLUTION_API_URL=https://your-evolution-api-domain.com
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE=your_instance_name

# Message pacing & typing delay configuration
OUTBOUND_MIN_DELAY=3.0
OUTBOUND_MAX_DELAY=8.0
EVOLUTION_TYPING_DELAY_MS=1200

# Comma-separated browser origins allowed to call this API (plus localhost for Vite).
# Set FRONTEND_URL to the public Railway frontend origin, e.g. https://your-frontend.up.railway.app
CORS_ORIGINS=
FRONTEND_URL=

# Frontend (Vite) build-time: public backend URL, not localhost, when deploying the UI.
# VITE_API_URL=https://your-backend.up.railway.app

